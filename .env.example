# Bifrost Gateway Configuration
BIFROST_URL=http://localhost:8080
BIFROST_SETUP_TOKEN=agentarena-setup-token-secret
BIFROST_ENCRYPTION_KEY=bifrost-secret-encryption-key-32

# Backend & Metering Proxy URL
ARENA_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Provider API Keys for Bifrost (populated as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Firebase Firestore Configuration
# Provide raw JSON string or path to serviceAccount.json file
FIREBASE_PROJECT_ID=agentarena-benchmark
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternatively, point to Firestore Emulator if running:
# FIRESTORE_EMULATOR_HOST=localhost:8085

# Benchmark Execution Settings
BENCHMARK_CONCURRENCY=3
DEFAULT_RUN_TIMEOUT_SECONDS=30
MAX_CALLS_PER_RUN=15
MAX_TOKENS_PER_RUN=60000

